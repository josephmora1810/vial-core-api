# Ignorar variables de entorno
.env

# Ignorar archivos ocultos del sistema
.DS_Store
Thumbs.db

# Ignorar imágenes de prueba (pueden contener datos personales)
scripts/*.jpg
scripts/*.png

# Ignorar archivos de caché de PHPUnit
.phpunit.cache/
.phpunit.result.cache
bin/.phpunit.result.cache

# Ignorar carpeta de visual studio code
.vscode/

# Almacenamiento local de archivos y evidencias KYC
storage/documents/*
storage/contracts/*
storage/logs/*
storage/certs/*.key
storage/certs/*.crt
!storage/documents/.gitkeep
!storage/contracts/.gitkeep
!storage/logs/.gitkeep
!storage/certs/openssl.cnf
!storage/certs/.gitkeep
