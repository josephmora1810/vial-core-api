# Environment
APP_ENV=local
APP_NAME=UbikGo
APP_RIF=J502098500
APP_TELEFONO=04267536320
APP_URL=http://localhost:8088

# MySql/MariaDB Options
DATABASE_NAME=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=

# Redis Options (this is absolutely necessary for the API to work, for throttling and caching)
REDIS_HOST=
REDIS_PORT=
REDIS_TIMEOUT=

# CurlHttpClient Options
HTTP_TIMEOUT=
HTTP_CONNECT_TIMEOUT=

# OCR Microservice (La Venezolana)
OCR_BASE_URL=http://localhost:8080/api/v1
OCR_API_KEY=

# JWT Options
JWT_SECRET=
JWT_TTL=3600

# Configuración SMTP
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465
SMTP_USERNAME=soporte@tudominio.com
SMTP_PASSWORD=tu_contraseña_secreta
SMTP_ENCRYPTION=ssl # o 'tls' para puerto 587
MAIL_FROM_ADDRESS=soporte@tudominio.com
MAIL_FROM_NAME="UbikGo Asistencia Vial"

# Pasarela Bancaribe (OAuth2, Tasas BCV, C2P, Consulta Plus y Saldos)
BANK_GATEWAY_DEFAULT=bancaribe
BANCARIBE_SANDBOX=false
BANCARIBE_PAYMENT_SANDBOX=true
BANCARIBE_FALLBACK_RATE=40.00
BANCARIBE_BASE_URL=
BANCARIBE_BASE_AUTH_URL=
BANCARIBE_COSTUMER_KEY=
BANCARIBE_COSTUMER_SECRET=
BANCARIBE_EXCHANGE_HASH=
BANCARIBE_C2P_HASH=
BANCARIBE_PLUS_HASH=
BANCARIBE_CHECK_BALANCE_HASH=
BANCARIBE_B2P_HASH=
BANCARIBE_OAUTH2_ENDPOINT=oauth2/token
BANCARIBE_EXCHANGE_ENDPOINT=BCVMicro/1.0.0/consultaTasa/tasa
BANCARIBE_C2P_ENDPOINT=C2P/1.0.0/registrarPagoC2pApi
BANCARIBE_PLUS_ENDPOINT=COP/1.0.0/consulta-operacion
BANCARIBE_CHECK_BALANCE_ENDPOINT=CtasSaldos/1.0.0/ctasConsultaSaldos
BANCARIBE_B2P_ENDPOINT=B2P/1.0.0/sendPaymentB2P
BANCARIBE_WEBHOOK_SECRET=ubikgo_webhook_secret_dev_key

# AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=

# OSRM Routing Machine (Cálculo de Rutas y Distancias SOS)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_ROUTE_ENDPOINT=route/v1

# Pusher WebSockets (Telemetría en Vivo y Alerta de Despacho SOS)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=sa1
PUSHER_PORT=443
PUSHER_SCHEME=https

# Seguridad CORS (Dominios autorizados separados por coma, ej: https://app.ubikgo.com,https://admin.ubikgo.com o * para local)
CORS_ALLOWED_ORIGINS=*


